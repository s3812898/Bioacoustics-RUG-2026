# 3. FIND AND LOAD FILES --------------------------------------

first_existing <- function(paths, description) {

  found <- paths[file.exists(paths)]

  if (!length(found)) {
    stop(
      description, " not found. Checked:\n",
      paste(paths, collapse = "\n")
    )
  }

  found[1]
}

harmonics_file <- first_existing(
  c(
    file.path(data_folder, harmonics_filename),
    file.path(
      project_folder, "Audio_files", "Clips",
      harmonics_filename
    ),
    file.path(
      project_folder, "Audio_files", "Trimmed_clips",
      harmonics_filename
    )
  ),
  "Harmonics CSV"
)

temperature_file <- first_existing(
  c(
    file.path(data_folder, temperature_filename),
    file.path(
      data_folder, "recording_temperature_data(2).xlsx"
    ),
    file.path(
      data_folder, "recording_temperature_data(1).xlsx"
    )
  ),
  "Temperature Excel file"
)

harmonics <- read.csv(
