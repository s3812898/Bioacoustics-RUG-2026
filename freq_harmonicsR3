    aes(
      x = Temperature,
      ymin = Lower95,
      ymax = Upper95,
      fill = "95% confidence interval"
    ),
    alpha = 0.40
  ) +

  # Mixed-model fitted regression line.

  geom_line(
    data = predictions,
    aes(
      x = Temperature,
      y = Fitted_dB,
      colour = "Mixed-model fit"
    ),
    linewidth = 1.1
  ) +

  # Orange recording-level medians.

  geom_point(
    data = recording_summary,
    aes(
      x = Temperature,
      y = Median_dB,
      colour = "Recording medians"
    ),
    size = 2.3,
    alpha = 0.90
  ) +

  # Separate panels for H2 and H3.

  facet_wrap(
    ~ Harmonic,
    nrow = 1
  ) +

  # Correct title and axis labels.

  labs(
    title = "Temperature vs Harmonic Amplitude",
    x = "Recording temperature (\u00B0C)",
    y = "Harmonic amplitude relative to $f_o$ (dB)"
  ) +

  figure_scales +

  scientific_theme


