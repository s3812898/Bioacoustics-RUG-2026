# ------------------------------------------------------------
# LEGEND AND AXIS SCALES
# ------------------------------------------------------------

# The legend uses actual symbols from the plotted objects:
# - geom_point -> circles
# - geom_line -> line
# - geom_ribbon -> shaded rectangle

figure_scales <- list(

  scale_colour_manual(
    values = plot_colours,
    breaks = names(plot_colours),
    name = NULL
  ),

  scale_fill_manual(
    values = band_colour,
    breaks = names(band_colour),
    name = NULL
  ),

  # Readable temperature tick spacing.

  scale_x_continuous(
    breaks = scales::breaks_pretty(n = 6),
    expand = expansion(
      mult = c(0.025, 0.025)
    )
  ),

  # Readable dB tick spacing.
  # Do not force the y-axis to start at zero.

  scale_y_continuous(
    breaks = scales::breaks_pretty(n = 6),
    expand = expansion(
      mult = c(0.04, 0.06)
    )
  ),

  guides(

    colour = guide_legend(
      order = 1,
      nrow = 1,
      override.aes = list(alpha = 1)
    ),

    fill = guide_legend(
      order = 2,
      nrow = 1
    )
  )
)


# 9. FIGURE 1: ONE MEDIAN PER RECORDING -----------------------

figure1 <- ggplot() +

  # Shaded 95% confidence interval.

  geom_ribbon(
