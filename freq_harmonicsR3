}


# 4. RECORDING IDs AND CRICKET IDs ----------------------------

standardize_id <- function(x) {

  x <- trimws(as.character(x))
  x <- sub("\\.[Ww][Aa][Vv]$", "", x)
  x <- sub("_[Cc]$", "", x)

  x
}

harmonics <- harmonics %>%
  mutate(
    RecordingID = standardize_id(File),
    CricketID = sub("_.*$", "", RecordingID),

    H2_RelativeAmplitude =
      suppressWarnings(as.numeric(H2_RelativeAmplitude)),

    H3_RelativeAmplitude =
      suppressWarnings(as.numeric(H3_RelativeAmplitude))
  )

temps <- temps %>%
  transmute(
    RecordingID = standardize_id(Audio),
    Temperature = suppressWarnings(as.numeric(Temperature))
  ) %>%
  filter(!is.na(RecordingID), nzchar(RecordingID))

if (any(!grepl("^[A-Za-z]{3}$", harmonics$CricketID))) {
  stop(
    "Some CricketID values are not three letters. ",
    "Check filename parsing."
  )
}


# 5. EXCLUDE UNRELIABLE RECORDINGS ----------------------------

manual_exclusions <- c(
  "KPP_n3_2",
  "PAS_n3_1",
  "SAB_n3_1",
  "SBA_2",
  "SKL_3",
  "PAS_n2_1",
  "SAB_n1_1",
  "SAB_2"
)

duplicated_temp_ids <- temps %>%
  count(RecordingID) %>%
  filter(n > 1) %>%
  pull(RecordingID)

missing_temp_ids <- temps %>%
  filter(!is.finite(Temperature)) %>%
  pull(RecordingID)

unmatched_ids <- setdiff(
  unique(harmonics$RecordingID),
  temps$RecordingID
)

weak_ids <- character()

if (apply_1percent_rule_in_R) {

  weak_rows <- with(
    harmonics,

    is.finite(H2_RelativeAmplitude) &
      is.finite(H3_RelativeAmplitude) &

      H2_RelativeAmplitude >= 0 &
      H3_RelativeAmplitude >= 0 &

      H2_RelativeAmplitude < min_relative_amplitude &
      H3_RelativeAmplitude < min_relative_amplitude
  )

  weak_ids <- unique(harmonics$RecordingID[weak_rows])
}

excluded_ids <- unique(
  c(
    manual_exclusions,
    duplicated_temp_ids,
    missing_temp_ids,
    unmatched_ids,
    weak_ids
  )
)

present_exclusions <- intersect(
  unique(harmonics$RecordingID),
  excluded_ids
)

exclusions <- data.frame(
  RecordingID = sort(present_exclusions)
)

exclusions$Reason <- vapply(
  exclusions$RecordingID,

  function(id) {

    reason <- character()

    if (id %in% manual_exclusions) {
      reason <- c(reason, "Previously unverified ID")
    }

    if (id %in% duplicated_temp_ids) {
      reason <- c(reason, "Duplicate temperature")
    }

    if (id %in% missing_temp_ids) {
      reason <- c(reason, "Missing temperature")
    }

    if (id %in% unmatched_ids) {
      reason <- c(reason, "No exact temperature match")
    }

    if (id %in% weak_ids) {
      reason <- c(
        reason, "Both H2 and H3 < 1% in a sample"
      )
    }

    paste(reason, collapse = "; ")
  },

  character(1)
)

write.csv(
  exclusions,
  file.path(
    output_folder, "Harmonics_Excluded_RecordingIDs.csv"
  ),
  row.names = FALSE
)

valid_temps <- temps %>%
  filter(
    !RecordingID %in% excluded_ids,
    is.finite(Temperature)
  )

joined <- harmonics %>%
  filter(!RecordingID %in% excluded_ids) %>%
  inner_join(valid_temps, by = "RecordingID")

if (!nrow(joined)) {
  stop("No valid recordings after exclusions.")
}


# 6. CALCULATE RECORDING MEDIANS ------------------------------

individual <- joined %>%
  select(
    RecordingID,
    CricketID,
    File,
    Temperature,
    any_of("ChirpNumber"),
    H2_RelativeAmplitude,
    H3_RelativeAmplitude
  ) %>%
  pivot_longer(
    cols = c(
      H2_RelativeAmplitude,
      H3_RelativeAmplitude
    ),
    names_to = "Harmonic",
    values_to = "RelativeAmplitude"
  ) %>%
  mutate(
    Harmonic = recode(
      Harmonic,
      H2_RelativeAmplitude = "H2",
      H3_RelativeAmplitude = "H3"
    ),

    RelativeAmplitude_dB =
      20 * log10(RelativeAmplitude)
  ) %>%
  filter(
    is.finite(RelativeAmplitude),
    RelativeAmplitude > 0,
    is.finite(RelativeAmplitude_dB)
  ) %>%
  mutate(
    Harmonic = factor(
      Harmonic,
      levels = c("H2", "H3")
    )
  )

recording_summary <- individual %>%
  group_by(
    RecordingID,
    CricketID,
    Temperature,
    Harmonic
  ) %>%
  summarise(
    N_SpectralSamples = n(),
    Median_dB = median(RelativeAmplitude_dB),
    Median_Ratio = median(RelativeAmplitude),
    .groups = "drop"
  ) %>%
  mutate(
    CricketID = factor(CricketID)
  )


# One row per recording for JASP.

jasp_ready <- recording_summary %>%
  select(
    RecordingID,
    CricketID,
    Temperature,
    Harmonic,
    Median_dB,
    N_SpectralSamples
  ) %>%
  pivot_wider(
    names_from = Harmonic,
    values_from = c(Median_dB, N_SpectralSamples),
    names_glue = "{.value}_{Harmonic}"
  ) %>%
  arrange(CricketID, RecordingID)

write.csv(
