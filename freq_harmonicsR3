# 7. LINEAR MIXED-EFFECTS MODELS ------------------------------

model_results <- list()
prediction_results <- list()
model_objects <- list()
fixed_effect_results <- list()

for (h in c("H2", "H3")) {

  ds <- recording_summary %>%
    filter(Harmonic == h) %>%
    mutate(
      CricketID = droplevels(CricketID)
    )

  if (
    n_distinct(ds$CricketID) < 2 ||
    n_distinct(ds$Temperature) < 2
  ) {
    warning(
      "Not enough crickets/temperatures for model ", h
    )
    next
  }

  mixed <- lmerTest::lmer(
    Median_dB ~ Temperature + (1 | CricketID),
    data = ds,
    REML = TRUE
  )

  model_objects[[h]] <- mixed

  tab <- coef(summary(mixed))

  b <- unname(
    tab["Temperature", "Estimate"]
  )

  se <- unname(
    tab["Temperature", "Std. Error"]
  )

  model_results[[h]] <- data.frame(
    Harmonic = h,
    N_Recordings = nrow(ds),
    N_Crickets = n_distinct(ds$CricketID),
    Slope_dB_per_C = b,
    StdError = se,
    DegreesFreedom = unname(
      tab["Temperature", "df"]
    ),
    t_value = unname(
      tab["Temperature", "t value"]
    ),
    p_value = unname(
      tab["Temperature", "Pr(>|t|)"]
    ),
    CI95_Lower = b - 1.96 * se,
    CI95_Upper = b + 1.96 * se,
    SingularFit = lme4::isSingular(mixed)
  )


  # Fixed-effect predictions and approximate 95% CI.

  newdata <- data.frame(
    Temperature = seq(
      min(ds$Temperature),
      max(ds$Temperature),
      length.out = 100
    )
  )

  X <- model.matrix(
    ~ Temperature,
    data = newdata
  )

  fe <- lme4::fixef(mixed)
  V <- as.matrix(vcov(mixed))

  fitted <- as.vector(X %*% fe)

  fitted_se <- sqrt(
    rowSums((X %*% V) * X)
  )

  prediction_results[[h]] <- data.frame(
    Harmonic = h,
    Temperature = newdata$Temperature,
    Fitted_dB = fitted,
    Lower95 = fitted - 1.96 * fitted_se,
    Upper95 = fitted + 1.96 * fitted_se
  )


  # Optional cricket fixed-effects sensitivity analysis.

  if (run_cricket_fixed_effect_model) {

    fixed <- lm(
      Median_dB ~ Temperature + CricketID,
      data = ds
    )

    ct <- coef(summary(fixed))

    if ("Temperature" %in% rownames(ct)) {

      fixed_effect_results[[h]] <- data.frame(
        Harmonic = h,
        Slope_dB_per_C =
          ct["Temperature", "Estimate"],
        StdError =
          ct["Temperature", "Std. Error"],
        p_value =
          ct["Temperature", "Pr(>|t|)"]
      )
    }
  }

  cat("\n=======", h, "MIXED MODEL =======\n")

  print(summary(mixed))

  if (lme4::isSingular(mixed)) {
    warning(
      h,
      " random-effect variance is near zero."
    )
  }
}

if (!length(model_results)) {
  stop("Neither mixed model could be fitted.")
}

results <- dplyr::bind_rows(model_results)

predictions <- dplyr::bind_rows(prediction_results)

write.csv(
